# Copy this file to .env and fill in what you have. Everything is optional:
# with no keys at all the app runs in DEMO mode (placeholder AI, no network calls).

# ---------- Sarvam AI (Indian languages: translation + voice) ----------
# Key from the Sarvam dashboard (see docs.sarvam.ai)
SARVAM_API_KEY=
# Free "Starter" plan allows 40 chat requests/min; the app slows itself down to stay under this.
SARVAM_RPM=36
# SARVAM_MODEL=sarvam-105b
# Studio voice (Bulbul). If this errors the app falls back to the browser's own voice.
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_TTS_SPEAKER=ishita

# ---------- IBM watsonx.ai (Granite) ----------
# IBM Cloud API key  (cloud.ibm.com/iam/apikeys)
WATSONX_API_KEY=
# watsonx.ai project id  (your project -> Manage -> General)
WATSONX_PROJECT_ID=
# Region endpoint: us-south | eu-de | eu-gb | jp-tok | au-syd ...
WATSONX_URL=https://us-south.ml.cloud.ibm.com
# Run `python scripts/list_models.py` to see the ids your project can use.
GEN_MODEL=ibm/granite-4-h-small
TRANSLATE_MODEL=
EMBED_MODEL=ibm/granite-embedding-278m-multilingual

# ---------- Who does which job (all optional; default is auto) ----------
# auto picks what you have keys for: Granite for generation, Sarvam for translation.
# Values: auto | watsonx | sarvam | mock          (EMBED_PROVIDER: auto | watsonx | local)
# GEN_PROVIDER=auto          simplify, quizzes, textbook answers
# TRANSLATE_PROVIDER=auto    translation + the translation quality check
# EMBED_PROVIDER=auto        textbook search
# SPEECH_PROVIDER=auto       auto | sarvam | browser   (browser = free, uses your device's voices)

# auto | mock   (mock forces demo mode even if keys are set)
VIDYASETU_MODE=auto
